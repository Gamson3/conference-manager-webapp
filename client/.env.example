# Client environment variables
# Copy this file to .env.local and fill in the values

# Where your backend API runs during development
# Backend defaults to PORT 3001 (see server/.env.example)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# AWS Cognito settings for Amplify Auth
NEXT_PUBLIC_AWS_COGNITO_REGION=us-east-1
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_CLIENT_ID=your_client_id_here
