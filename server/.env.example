# Server environment variables
# Copy this file to .env and fill in the values

# Prisma/Postgres
# Example with local Postgres and public schema
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/conference_manager?schema=public"

# API server
PORT=3001

# AWS/Cognito (used by auth controllers and JWT verification)
# Region must be just the AWS region (e.g., "eu-north-1"), NOT the full pool id
AWS_REGION=us-east-1
# The Cognito User Pool ID (e.g., "eu-north-1_ABC123xyz")
AWS_COGNITO_USER_POOL_ID=your_user_pool_id_here
# App Client ID (used to validate ID token audience)
AWS_COGNITO_USER_POOL_CLIENT_ID=your_cognito_user_pool_client_id_here

# ============================================================
# R2/S3 Object Storage (for file uploads)
# ============================================================
# Set STORAGE_DRIVER to 'r2' to use Cloudflare R2, or 'local' for local disk
# If not set, auto-detects based on whether R2 credentials are present
STORAGE_DRIVER=local

# Cloudflare R2 configuration (required when STORAGE_DRIVER=r2)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Optional: Custom endpoint (defaults to https://{account_id}.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional: Public URL for public assets (e.g., custom domain or R2.dev URL)
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
